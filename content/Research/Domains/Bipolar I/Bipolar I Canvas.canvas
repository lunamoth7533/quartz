		{
			"id": "t0_0",
			"type": "text",
			"text": "**[[Bipolar I episodes and course]]**\n*condition* - 5 sources\n\nEpisode definitions against the lifetime course, and why acute and long-term questions must be separated in this condition.",
			"x": 30,
			"y": 508,
			"width": 360,
